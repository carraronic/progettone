            <Insets bottom="100.0" top="40.0" />
         </VBox.margin></ImageView>
      <VBox alignment="CENTER" focusTraversable="true" prefHeight="200.0" prefWidth="100.0" spacing="20.0">
         <children>
            <Button fx:id="btn1" focusTraversable="false" mnemonicParsing="false" onAction="#restart" prefHeight="50.0" prefWidth="200.0" text="RESTART" />
